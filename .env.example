# Copy to .env.local for local development. Configure in Vercel Project Settings for production.
# Never commit real secrets to Git.

# --------------------------------------------------------------------------
# Site & Canonical URL Configuration
# --------------------------------------------------------------------------
# Canonical origin (no trailing slash). Set to your live production domain (e.g. https://hrc.novixa.dev or https://hrc-ahgaff.org).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --------------------------------------------------------------------------
# Communication & Contact Channels
# --------------------------------------------------------------------------
# WhatsApp number in international format without "+" (e.g. 9675XXXXXXX).
# Leave empty to hide the WhatsApp contact button.
NEXT_PUBLIC_WHATSAPP=

# Contact Form Email Delivery via Resend (https://resend.com)
# Without RESEND_API_KEY, submissions are logged structurally to console in dev/staging.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@hrc-ahgaff.org
CONTACT_FROM_EMAIL=onboarding@resend.dev

# --------------------------------------------------------------------------
# Google AI Studio / Gemini Integration (https://aistudio.google.com)
# --------------------------------------------------------------------------
# Free API Key from Google AI Studio. Unlocks live AI Research Assistant on the web portal.
# If empty, the website uses the built-in offline academic knowledge engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --------------------------------------------------------------------------
# Privacy-Friendly Analytics (Optional)
# --------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS=
